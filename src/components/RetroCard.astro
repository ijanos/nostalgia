---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  screenshot: CollectionEntry<'screenshot'>;
}

const { screenshot } = Astro.props;
const { Content } = await render(screenshot);

const label = screenshot.id.split('/').pop() ?? screenshot.id;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] shadow-[0_2px_20px_rgba(0,0,0,0.4)] backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/50 hover:shadow-[0_10px_50px_rgba(0,240,255,0.18)]"
>
  <div class="relative overflow-hidden border-b border-white/10 bg-black/30">
    <a
      class="gallery block cursor-zoom-in"
      href={screenshot.data.image.src}
      data-pswp-width={screenshot.data.image.width}
      data-pswp-height={screenshot.data.image.height}
    >
      <img
        src={screenshot.data.image.src}
        alt={`Screenshot from ${label}`}
        loading="lazy"
        class="w-full scale-100 grayscale-[30%] sepia-[15%] transition-all duration-500 group-hover:scale-[1.04] group-hover:grayscale-0 group-hover:sepia-0"
      />
    </a>
    <div class="scanlines pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/10" aria-hidden="true"></div>
    <div class="absolute left-3 top-3 rounded border border-cyan-400/40 bg-black/70 px-2 py-0.5 font-mono text-[11px] tracking-[0.2em] text-cyan-300 backdrop-blur-sm">
      {label}
    </div>
    <div class="absolute right-3 top-3 h-2 w-2 animate-pulse rounded-full bg-red-500/90" aria-hidden="true"></div>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5 font-mono text-sm leading-relaxed text-neutral-300">
    <div class="flex items-center gap-2 text-xs text-neutral-500">
      <span class="text-cyan-400">$</span>
      <span class="tracking-widest">cat {label}.txt</span>
      <span class="blink inline-block h-3 w-2 bg-green-400" aria-hidden="true"></span>
    </div>
    <div
      class="prose prose-invert prose-sm prose-neutral max-w-none prose-p:leading-relaxed prose-headings:font-mono prose-h1:mt-0 prose-h1:text-lg prose-h2:text-base prose-a:text-cyan-300 prose-a:underline prose-a:decoration-dotted prose-a:underline-offset-4 hover:prose-a:text-cyan-200 prose-code:text-wrap prose-pre:border prose-pre:border-white/10 prose-pre:bg-black/60"
    >
      <Content />
    </div>
  </div>
</article>
